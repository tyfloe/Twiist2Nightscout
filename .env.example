# Tidepool account linked to your My twiist Portal
TIDEPOOL_USER=
TIDEPOOL_PASSWORD=
# Optional: Tidepool user ID of a *shared* account to read (follower/caregiver). Defaults to your own.
# TIDEPOOL_USER_ID=

NIGHTSCOUT_URL=
# Use ONE of these:
NIGHTSCOUT_API_SECRET=
# NIGHTSCOUT_TOKEN=

POLL_SECONDS=120
BACKFILL_HOURS=24
LOG_LEVEL=INFO

# --- EXPERIMENTAL: Eversense NOW follower (separate Eversense sensor) ---
# Use the *follower* account login. Leave blank to disable. If the same sensor already reaches
# Nightscout through twiist/Tidepool, do NOT enable this too or you'll get duplicate readings.
 #EVERSENSE_USER=
 #EVERSENSE_PASSWORD=
# The Eversense app's client secret; see README. Not something I can supply.
 EVERSENSE_CLIENT_SECRET="vYL4yrvM_E\"K"
# EVERSENSE_REGION=US          # or OUS
# EVERSENSE_PATIENT_ID=        # only if you follow more than one person

# User-Agent sent on all outgoing requests. If Eversense still answers 403 / "error code: 1010",
# Cloudflare is still rejecting it; try a different value here.
# HTTP_USER_AGENT=
